{
  "name": "study-room",
  "version": "1.0.0",
  "description": "友達と同じ部屋で勉強できる時間記録アプリ",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project studywith-9090d",
    "dev:emulator": "VITE_FIREBASE_EMULATOR=true vite",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test \"vitest run -c vitest.rules.config.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traumwal/studywith.git"
  },
  "bugs": {
    "url": "https://github.com/traumwal/studywith/issues"
  },
  "homepage": "https://github.com/traumwal/studywith#readme",
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "15.36.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "private": true,
  "type": "module"
}
