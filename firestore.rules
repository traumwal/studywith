rules_version = '2';

// 友達だけの部屋：部屋のメンバーだけが部屋と在席状態を読める。
// 勉強記録（sessions）は本人だけが読み書きできる。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 30;

      match /sessions/{sessionId} {
        allow read, write: if isMe(uid);
      }
    }

    match /rooms/{roomId} {
      function members() { return resource.data.memberIds; }
      function isMember() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
      }
      function newMembers() { return request.resource.data.memberIds; }
      function othersUnchanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      }

      // 招待コード（= roomId）を知っている人は、参加前に部屋の有無・人数を確認できる。
      // コードを知っていれば参加できるのと同じなので、これで守りが弱くなることはない。
      // 一覧の取得（list）はメンバーだけ。
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in members();

      allow create: if signedIn()
        && newMembers() == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt is number;

      // 参加：自分だけを追加（最大2人。src/constants.ts の MAX_ROOM_MEMBERS と合わせる） / 退出：自分だけを削除
      allow update: if signedIn() && othersUnchanged() && (
        (newMembers().hasAll(members())
          && newMembers().removeAll(members()).hasOnly([request.auth.uid])
          && newMembers().size() <= 2)
        ||
        (members().hasAll(newMembers())
          && members().removeAll(newMembers()).hasOnly([request.auth.uid]))
      );

      match /presence/{uid} {
        allow read: if isMember();
        allow create, update: if isMe(uid) && isMember();
        // 退出後でも自分の在席情報は消せるようにする
        allow delete: if isMe(uid);
      }

      // スタンプ・自動メッセージ。メンバーだけが読み書きでき、送ったものは変更・削除できない
      match /messages/{messageId} {
        function validMessage(d) {
          return d.keys().hasOnly(['senderId', 'kind', 'text', 'createdAt'])
            && d.senderId == request.auth.uid
            && d.kind in ['stamp', 'auto-start', 'auto-break', 'auto-stop']
            && d.text is string
            && d.text.size() > 0
            && d.text.size() <= 40                                   // MAX_MESSAGE_LEN
            && d.createdAt is number
            && d.createdAt > request.time.toMillis() - 60 * 1000     // 端末の時計のずれは ±1 分まで
            && d.createdAt < request.time.toMillis() + 60 * 1000;
        }
        allow read: if isMember();
        allow create: if isMember() && validMessage(request.resource.data);
        allow update, delete: if false;
      }

      // タイムライン用の共有コピー（分野と開始・終了時刻だけ）。2 日後に TTL で消える
      match /timeline/{entryId} {
        function validEntry(d) {
          return d.keys().hasOnly(['userId', 'category', 'startedAt', 'endedAt', 'expireAt'])
            && d.userId == request.auth.uid
            && d.category is string
            && d.category.size() > 0
            && d.category.size() <= 30
            && d.startedAt is number
            && d.endedAt is number
            && d.endedAt > d.startedAt
            && d.endedAt < request.time.toMillis() + 60 * 1000
            && d.expireAt is timestamp
            && d.expireAt.toMillis() == d.endedAt + 2 * 24 * 60 * 60 * 1000;   // TIMELINE_KEEP_MS
        }
        allow read: if isMember();
        allow create: if isMember() && validEntry(request.resource.data);
        allow update: if false;
        // 記録を消したときに一緒に消す。部屋を出た後でも自分の分は消せる
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
